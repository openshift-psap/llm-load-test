FROM python:3.12-slim

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Install llm-load-test from the repository root
COPY pyproject.toml load_test.py requirements.txt ./
COPY src/ ./src/
COPY datasets/ ./datasets/
RUN pip install --no-cache-dir .

WORKDIR /app

# Install runner-specific dependencies
COPY contrib/prometheus-exporter/runner/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY contrib/prometheus-exporter/runner/runner.py ./
COPY contrib/prometheus-exporter/runner/datasets/ ./datasets/

CMD ["python", "runner.py"]
